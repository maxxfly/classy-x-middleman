---
  title: rental.title
---

<div id="description">
  <%= breadcrumb(t("rental.title")) %>

  <h1><%= t("rental.title") %></h1>

  <div class="sub_part">

    <p>
      <%= t("rental.p1.line1") %><br/>
      <%= t("rental.p1.line2") %><br/>
    </p>
  
    <div style="margin-left: 30px; margin-top: 10px">
      <h3 class="item_title"><%= t("rental.items.item1.title") %>:</h3>
      <%= t("rental.items.item1.description") %><br/><br/>

      <h3 class="item_title"><%= t("rental.items.item2.title") %>:</h3>
      <%= t("rental.items.item2.description") %><br/><br/>

      <h3 class="item_title"><%= t("rental.items.item3.title") %>:</h3>
      <%= t("rental.items.item3.description") %><br/><br/>

    </div>

    <p>
      <%= t("rental.p2.line1") %><br/>
    </p>
  </div>


</div>